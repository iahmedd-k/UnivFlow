# ==============================================================================
# UNIFLOW - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Default credentials (used by portals unless overridden)
UNIV_EMAIL=your_student_email@university.edu.pk
UNIV_PASSWORD=your_secure_password

# Optional per-portal credential overrides (if specific portals use different credentials)
# AIR_UNIV_EMAIL=student_reg_no@au.edu.pk
# AIR_UNIV_PASSWORD=air_portal_password
# LMS_PORTAL_EMAIL=student@lms.edu.pk
# LMS_PORTAL_PASSWORD=lms_password

# General Settings
# Browser headless mode: false (recommended for first-time login & Google auth), true (can be set to true for credentials-only after verification)
HEADLESS=false

# Global navigation timeout in milliseconds (default: 60000ms = 60s)
DEFAULT_TIMEOUT_MS=60000

# Manual login waiting timeout in milliseconds (default: 120000ms = 120s)
MANUAL_LOGIN_TIMEOUT_MS=120000

# ============================================================================
# Independent assignment agent model setup (backend)
# ============================================================================
GROQ_API_KEY=
GEMINI_API_KEY=
POLLINATIONS_API_KEY=
PLANNER_AGENT_MODEL=openai/gpt-oss-120b
THEORY_AGENT_MODEL=gemini-3.8-flash
CODER_AGENT_MODEL=qwen/qwen3.8-27b
REPORTER_AGENT_MODEL=gemini-3.5-flash-lite

# ==============================================================================
# CODE EXECUTION CONFIGURATION
# ==============================================================================

# Piston Configuration
# Piston is a self-hosted code execution service
PISTON_BASE_URL=http://localhost:2000
PISTON_TIMEOUT_SECONDS=30

# Code Execution Limits
CODE_EXECUTION_TIMEOUT_SECONDS=10
CODE_EXECUTION_MAX_ATTEMPTS=3
CODE_EXECUTION_MAX_OUTPUT_BYTES=100000
CODE_EXECUTION_MAX_CODE_BYTES=100000

# Database Execution Configuration
# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# MongoDB
MONGODB_URI=
MONGODB_DATABASE=

# SQLite
SQLITE_EXECUTION_PATH=./tmp/sqlite

# ==============================================================================
# DIAGRAM GENERATION CONFIGURATION
# ==============================================================================

# Kroki Configuration
# Kroki is a diagram rendering service (https://kroki.io)
# For self-hosted: KROKI_BASE_URL=http://localhost:8000
KROKI_BASE_URL=https://kroki.io
KROKI_TIMEOUT_SECONDS=30

# Diagram Generation Limits
DIAGRAM_MAX_SOURCE_BYTES=100000
DIAGRAM_MAX_ATTEMPTS=2
DIAGRAM_TIMEOUT_SECONDS=30
