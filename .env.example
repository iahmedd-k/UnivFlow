# ==============================================================================
# UNIFLOW ATTENDANCE AUTOMATION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Default credentials (used by portals unless overridden)
UNIV_EMAIL=your_student_email@university.edu.pk
UNIV_PASSWORD=your_secure_password

# Optional per-portal credential overrides (if specific portals use different credentials)
# AIR_UNIV_EMAIL=student_reg_no@au.edu.pk
# AIR_UNIV_PASSWORD=air_portal_password
# LMS_PORTAL_EMAIL=student@lms.edu.pk
# LMS_PORTAL_PASSWORD=lms_password

# General Settings
# Browser headless mode: false (recommended for first-time login & Google auth), true (can be set to true for credentials-only after verification)
HEADLESS=false

# Global navigation timeout in milliseconds (default: 60000ms = 60s)
DEFAULT_TIMEOUT_MS=60000

# Manual login waiting timeout in milliseconds (default: 120000ms = 120s)
MANUAL_LOGIN_TIMEOUT_MS=120000
