FROM mcr.microsoft.com/playwright/python:v1.63.0-noble

ENV PYTHONUNBUFFERED=1 \
    BROWSER_PROFILE_ROOT=/data/profiles \
    NOVNC_ROOT=/usr/share/novnc \
    PYTHONPATH=/app/backend

RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb fluxbox x11vnc novnc \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --ignore-installed \
    "fastapi==0.111.0" \
    "playwright==1.63.0" \
    "uvicorn[standard]==0.34.0" \
    && python -c "from pathlib import Path; from playwright.sync_api import sync_playwright; p = sync_playwright().start(); assert Path(p.chromium.executable_path).is_file(); p.stop()"

WORKDIR /app/backend
COPY app/services/browser_host.py /app/backend/app/services/browser_host.py

EXPOSE 7900 12000-21999
CMD ["python", "/app/backend/app/services/browser_host.py"]
