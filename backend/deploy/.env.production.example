# Copy this to /home/<vm-user>/univflow-deploy/.env.production on the Azure VM.
# Replace every placeholder. Do not commit the completed file.
APP_DOMAIN=univ-flow-bt12.vercel.app
API_DOMAIN=univlfow.koreacentral.cloudapp.azure.com
MAX_BROWSER_SESSIONS=1

# Supabase: use the session pooler URL, port 5432, with sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
UPSTASH_REDIS_REST_URL=https://<redis-database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Generate each secret independently with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
BROWSER_SERVICE_TOKEN=replace-with-a-different-long-random-secret
BROWSER_VIEWER_SECRET=replace-with-another-long-random-secret

# Supabase Storage S3 endpoint and credentials; create the uniflow-files bucket first.
S3_BUCKET_URL=https://<project-ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY=replace-with-supabase-s3-access-key
S3_SECRET_KEY=replace-with-supabase-s3-secret-key

# Configure only the external integrations used by this deployment.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://univlfow.koreacentral.cloudapp.azure.com/api/v1/auth/google
GROQ_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
