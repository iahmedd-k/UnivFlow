{
  "manifest_version": 3,
  "name": "Uniflow Academic Companion",
  "version": "1.3.6",
  "description": "1-Click session synchronization & auto-turn-in companion for Claude.ai, Google Classroom, and University Portal.",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://classroom.google.com/*",
    "https://accounts.google.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://google.com/*",
    "https://*.google.com/*",
    "*://*.google.com/*",
    "<all_urls>",
    "https://portals.au.edu.pk/*",
    "http://localhost:8000/*",
    "http://localhost:3000/*",
    "https://*.azure.com/*",
    "https://*.cloudapp.azure.com/*",
    "https://*.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.vercel.app/*",
        "https://univ-flow-bt12.vercel.app/*",
        "https://*.cloudapp.azure.com/*",
        "https://univlfow.koreacentral.cloudapp.azure.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uniflow Companion Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
