{
  "manifest_version": 3,
  "name": "Uniflow Academic Companion",
  "version": "1.1.0",
  "description": "1-Click session synchronization for Claude.ai, Google Classroom, and University Portal.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uniflow Claude Sync"
  }
}
