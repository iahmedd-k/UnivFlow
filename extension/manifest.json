{
  "manifest_version": 3,
  "name": "Uniflow Claude Companion",
  "version": "1.0.0",
  "description": "1-Click Claude.ai session synchronization for Uniflow autonomous assignment solver.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uniflow Claude Sync"
  }
}
